{
    "app": {
        "name": "Version Build Project",
        "version": "1.0.0",
        "debug": true
    },
    "logging": {
        "level": "INFO",
        "file": "logs/app.log",
        "max_size": "10MB",
        "backup_count": 5
    },
    "auth": {
        "session_timeout": 3600,
        "max_login_attempts": 3,
        "password_min_length": 8
    },
    "database": {
        "type": "sqlite",
        "path": "data/app.db",
        "backup_interval": 86400
    }
}
